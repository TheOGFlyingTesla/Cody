{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cody-coordinator.local/schema/journal-v1.json",
  "title": "Cody Coordinator run journal",
  "type": "object",
  "required": [
    "schema_version",
    "standard_name",
    "standard_version",
    "run_id",
    "command",
    "created_at",
    "updated_at",
    "repository_identity",
    "authority",
    "starting_git",
    "post_apply_git",
    "source_files",
    "planned_operations",
    "phase_history",
    "file_hashes",
    "validation",
    "report_path",
    "report_sha256",
    "status",
    "next_action"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "standard_name": {"type": "string", "const": "cody-coordinator"},
    "standard_version": {"type": "string", "enum": ["0.1.0", "3.0.0", "3.1.0", "3.2.0", "3.2.1", "3.2.2", "3.2.3", "3.2.4", "3.2.5", "3.2.6"]},
    "run_id": {"type": "string", "format": "uuid"},
    "command": {
      "type": "string",
      "enum": ["init", "upgrade", "repair", "recover"]
    },
    "project_slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "repository_identity": {"$ref": "#/$defs/repository_identity"},
    "authority": {"$ref": "#/$defs/authority"},
    "starting_git": {"$ref": "#/$defs/git_evidence"},
    "post_apply_git": {"$ref": "#/$defs/git_evidence"},
    "source_files": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_file"},
      "maxItems": 4096,
      "uniqueItems": true
    },
    "planned_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/operation"},
      "maxItems": 64
    },
    "phase_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/phase_entry"},
      "maxItems": 5
    },
    "file_hashes": {
      "type": "array",
      "items": {"$ref": "#/$defs/file_hash"},
      "maxItems": 128
    },
    "validation": {
      "type": "array",
      "items": {"$ref": "#/$defs/validation"},
      "maxItems": 1024
    },
    "report_path": {"$ref": "#/$defs/relative_path"},
    "report_sha256": {
      "type": "string",
      "pattern": "^(?:|[0-9a-f]{64})$"
    },
    "status": {"$ref": "#/$defs/status"},
    "next_action": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": false,
  "$defs": {
    "phase": {
      "type": "string",
      "enum": ["inspect", "plan", "apply", "validate", "finalize"]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "in-progress", "blocked", "failed", "complete", "superseded"]
    },
    "nullable_string": {"type": ["string", "null"]},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001F]+$"
    },
    "sha256_or_null": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_identity": {
      "type": "object",
      "required": ["project_id", "fingerprint", "provisional", "basename"],
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provisional": {"type": "boolean"},
        "basename": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "command",
        "mutation_classes",
        "allowed_paths",
        "decisions",
        "created_at",
        "source_id"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "mutation_classes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "allowed_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relative_path"},
          "uniqueItems": true
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "evidence_sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "created_at": {"type": "string", "format": "date-time"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "git_evidence": {
      "type": "object",
      "required": [
        "kind",
        "head",
        "explicit_base",
        "branch",
        "is_detached",
        "worktree_identity_sha256",
        "common_dir_identity_sha256",
        "staged_managed_paths",
        "unstaged_managed_paths",
        "untracked_managed_paths"
      ],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/nullable_string"},
        "explicit_base": {"$ref": "#/$defs/nullable_string"},
        "branch": {"$ref": "#/$defs/nullable_string"},
        "is_detached": {"type": "boolean"},
        "worktree_identity_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "common_dir_identity_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "staged_managed_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relative_path"},
          "uniqueItems": true
        },
        "unstaged_managed_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relative_path"},
          "uniqueItems": true
        },
        "untracked_managed_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relative_path"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "reversal": {
      "type": "object",
      "required": ["kind", "reference", "metadata"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["delete-new", "remove-inserted-block", "restore-git-base", "restore-template", "unavailable"]
        },
        "reference": {"$ref": "#/$defs/nullable_string"},
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["action", "relative_path", "before_sha256", "after_sha256", "reversal"],
      "properties": {
        "action": {"type": "string", "enum": ["create", "replace", "git-init"]},
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "before_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "after_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "reversal": {"$ref": "#/$defs/reversal"}
      },
      "additionalProperties": false
    },
    "source_file": {
      "type": "object",
      "required": ["relative_path", "sha256", "disposition"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disposition": {
          "type": "string",
          "enum": ["mapped", "retained", "normalized-in-place", "legacy-evidence"]
        }
      },
      "additionalProperties": false
    },
    "phase_entry": {
      "type": "object",
      "required": ["phase", "at", "evidence"],
      "properties": {
        "phase": {"$ref": "#/$defs/phase"},
        "at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "file_hash": {
      "type": "object",
      "required": ["relative_path", "before_sha256", "after_sha256"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "before_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "after_sha256": {"$ref": "#/$defs/sha256_or_null"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["name", "ok", "severity", "message"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "ok": {"type": "boolean"},
        "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "info"]},
        "message": {"type": "string", "maxLength": 500}
      },
      "additionalProperties": false
    }
  }
}
